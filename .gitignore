# ─────────────────────────────────────────────────────────────────────────
# SAFETY WHITELIST — DO NOT LOOSEN.
#
# This home directory (/Users/kmk) is the git root for the PUBLIC repo
# github.com/Kevin-Kurka/heroes. A careless `git add -A` here could otherwise
# stage and publish secrets sitting in your home folder (.ssh, .aws, .pgpass,
# wallet*.json, passwordsused.md, etc.).
#
# So: ignore EVERYTHING by default, then allow only the files this repo is
# meant to contain. Add a top-level path below ONLY if you mean to publish it.
# ─────────────────────────────────────────────────────────────────────────
/*
!/.gitignore
!/.cursor/
!/Heroes/

# Junk that should never be committed even inside the allowed tree.
.DS_Store
*.swp

# ── Legacy patterns below (redundant under the whitelist, kept for clarity) ──

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage / build artifacts
lib-cov
coverage
.nyc_output
.grunt
bower_components
.lock-wscript
build/Release

# Dependency directories
node_modules/

# Caches & misc
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# dotenv environment variables file
.env
