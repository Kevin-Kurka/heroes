NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_ELFSIGHT_APP_ID=

# Google Analytics 4 — Measurement ID from analytics.google.com (Admin →
# Data streams → your web stream). Format: G-XXXXXXXXXX. GA is only loaded
# when this is set.
NEXT_PUBLIC_GA_ID=

# Google Search Console — verification token (HTML-tag method): the `content`
# value from the <meta name="google-site-verification" ...> tag Search Console
# gives you. Renders the verification meta tag when set.
GOOGLE_SITE_VERIFICATION=
