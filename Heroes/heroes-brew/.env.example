NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_ELFSIGHT_APP_ID=

# Google Analytics 4 — Measurement ID from analytics.google.com (Admin →
# Data streams → your web stream). Format: G-XXXXXXXXXX. GA is only loaded
# when this is set.
NEXT_PUBLIC_GA_ID=

# Google Search Console — verification token (HTML-tag method): the `content`
# value from the <meta name="google-site-verification" ...> tag Search Console
# gives you. Renders the verification meta tag when set.
GOOGLE_SITE_VERIFICATION=

# Live menu Google Sheet (optional) — when set, /menu and /menu/printable render
# from this published CSV instead of the bundled static menu, so anyone with edit
# access to the sheet can update the live menu. Use the sheet's "Publish to web"
# CSV link, or (if the sheet is shared "anyone with the link: Viewer") the gviz CSV:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/gviz/tq?tqx=out:csv
# Falls back to src/lib/menu.ts if unset or the fetch fails. Pages revalidate hourly.
MENU_SHEET_CSV_URL=
